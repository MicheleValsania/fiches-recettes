# Frontend (local dev -> Railway backend)
VITE_API_BASE=https://fiches-recettes-backend-production.up.railway.app/api

# Railway Postgres (public TCP)
PGHOST=centerbeam.proxy.rlwy.net
PGPORT=15669
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD
PGDATABASE=railway

# Backend authentication (Railway service variables only)
AUTH_DISABLED=false
APP_PASSWORD=CHOOSE_A_NEW_LONG_PASSWORD
AUTH_TOKEN_SECRET=GENERATE_A_RANDOM_SECRET
FICHES_SERVICE_TOKEN=GENERATE_A_DIFFERENT_RANDOM_SECRET
AUTH_TOKEN_TTL_SECONDS=28800
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
ALLOW_DB_RESET=false
# DB_RESET_TOKEN=GENERATE_ANOTHER_SECRET_ONLY_IF_RESET_IS_ENABLED

# Keep these values stable after the first multi-tenant migration.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_TENANT_SLUG=chefside-france
DEFAULT_TENANT_NAME=ChefSide France


# Invitation-only tenant registration. A code is mandatory when enabled.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=GENERATE_A_RANDOM_INVITATION_CODE
